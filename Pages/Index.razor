@page "/"
@inject LocalizationService Loc
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Syimyk Zhusupov — Junior .NET Developer</PageTitle>

<div class="bg-glow bg-glow-1"></div>
<div class="bg-glow bg-glow-2"></div>

<nav class="navbar">
    <div class="navbar-inner">
        <a href="#app" class="logo" @onclick='() => Scroll("app")' @onclick:preventDefault>
            SZ<span class="accent">.</span>
        </a>

        <!-- Desktop Navigation -->
        <div class="nav-links">
            <a href="#about" @onclick='() => Scroll("about")' @onclick:preventDefault>@Loc.T("nav.about")</a>
            <a href="#skills" @onclick='() => Scroll("skills")' @onclick:preventDefault>@Loc.T("nav.skills")</a>
            <a href="#projects" @onclick='() => Scroll("projects")' @onclick:preventDefault>@Loc.T("nav.projects")</a>
            <a href="#education" @onclick='() => Scroll("education")' @onclick:preventDefault>@Loc.T("nav.education")</a>
            <a href="#contact" @onclick='() => Scroll("contact")' @onclick:preventDefault>@Loc.T("nav.contact")</a>
        </div>

        <div class="nav-actions">
            <button class="lang-toggle" @onclick="ToggleLang" aria-label="Switch language">
                <span class="@(Loc.CurrentLang == "en" ? "active" : "")">EN</span>
                <span class="sep">/</span>
                <span class="@(Loc.CurrentLang == "pl" ? "active" : "")">PL</span>
            </button>

            <!-- Mobile Hamburger Toggle -->
            <button class="mobile-menu-btn" @onclick="ToggleMobileMenu" aria-label="Toggle navigation">
                <span>@(isMobileMenuOpen ? "✕" : "☰")</span>
            </button>
        </div>
    </div>

    <!-- Mobile Navigation Dropdown -->
    @if (isMobileMenuOpen)
    {
        <div class="mobile-nav-menu">
            <a href="#about" @onclick='() => MobileNavClick("about")'>@Loc.T("nav.about")</a>
            <a href="#skills" @onclick='() => MobileNavClick("skills")'>@Loc.T("nav.skills")</a>
            <a href="#projects" @onclick='() => MobileNavClick("projects")'>@Loc.T("nav.projects")</a>
            <a href="#education" @onclick='() => MobileNavClick("education")'>@Loc.T("nav.education")</a>
            <a href="#contact" @onclick='() => MobileNavClick("contact")'>@Loc.T("nav.contact")</a>
        </div>
    }
</nav>

<header class="hero">
    <div class="hero-content">
        <!-- Status Pill -->
        <div class="status-pill reveal">
            <span class="status-dot"></span>
            <span>@Loc.T("hero.badge")</span>
        </div>

        <p class="hero-kicker reveal">Syimyk Zhusupov</p>
        <h1 class="hero-title reveal">
            <span class="typewriter">@Loc.T("hero.role")</span>
        </h1>
        <p class="hero-tagline reveal">@Loc.T("hero.tagline")</p>

        <div class="hero-actions reveal">
            <a class="btn btn-primary" href="#contact" @onclick='() => Scroll("contact")' @onclick:preventDefault>@Loc.T("hero.cta.contact")</a>
            <a class="btn btn-ghost" href="files/Syimyk_Zhusupov_CV.pdf" target="_blank" download>@Loc.T("hero.cta.cv") <span>↓</span></a>
        </div>

        <!-- Quick Social Links in Hero -->
        <div class="hero-socials reveal">
            <a href="https://github.com/cyimyk" target="_blank" rel="noopener noreferrer" class="social-chip" title="GitHub">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                <span>GitHub</span>
            </a>
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-chip" title="LinkedIn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                <span>LinkedIn</span>
            </a>
            <button class="social-chip" @onclick="CopyEmail" title="Copy Email">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                <span>Email</span>
            </button>
        </div>
    </div>
    <div class="scroll-indicator reveal"><span></span></div>
</header>

<!-- About Section -->
<section id="about" class="section reveal">
    <span class="section-num">01</span>
    <h2 class="section-title">@Loc.T("about.title")</h2>
    <p class="about-text">@Loc.T("about.text")</p>
    <p class="about-location">📍 @Loc.T("about.location")</p>
</section>

<!-- Categorized Skills Section -->
