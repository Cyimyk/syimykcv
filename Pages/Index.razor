        <div class="cert-card cert-clickable" @onclick='() => ShowCert("certificates/cert2-python-essentials.pdf")'>
            <strong>@Loc.T("cert2")</strong>
            <span>@Loc.T("certs.issuer")</span>
            <span class="cert-view-btn">@Loc.T("certs.view") →</span>
        </div>
        <div class="cert-card cert-clickable" @onclick='() => ShowCert("certificates/cert3-network-support-security.pdf")'>
            <strong>@Loc.T("cert3")</strong>
            <span>@Loc.T("certs.issuer")</span>
            <span class="cert-view-btn">@Loc.T("certs.view") →</span>
        </div>
        <div class="cert-card cert-clickable" @onclick='() => ShowCert("certificates/cert4-ethical-hacker.pdf")'>
            <strong>@Loc.T("cert4")</strong>
            <span>@Loc.T("certs.issuer")</span>
            <span class="cert-view-btn">@Loc.T("certs.view") →</span>
        </div>
        <div class="cert-card cert-clickable" @onclick='() => ShowCert("certificates/cert5-spaceshield-hackathon.pdf")'>
            <strong>@Loc.T("cert5")</strong>
            <span>@Loc.T("certs.issuer.hackathon")</span>
            <span class="cert-view-btn">@Loc.T("certs.view") →</span>
        </div>
