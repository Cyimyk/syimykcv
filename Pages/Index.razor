            </div>
            <div class="tag-cloud">
                <span class="tag tag-accent">C# 12</span>
                <span class="tag tag-accent">.NET 8</span>
                <span class="tag tag-accent">ASP.NET Core Web API</span>
                <span class="tag">RESTful APIs</span>
                <span class="tag">JWT Authentication</span>
                <span class="tag">DTO Pattern</span>
