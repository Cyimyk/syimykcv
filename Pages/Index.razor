<!-- Contact Section -->
<section id="contact" class="section reveal contact-section">
    <span class="section-num">05</span>
    <h2 class="section-title">@Loc.T("contact.title")</h2>
    <p class="about-text">@Loc.T("contact.text")</p>

    <div class="contact-grid">
        <div class="contact-card contact-card-action" @onclick="CopyEmail" title="Click to copy email">
            <span class="contact-label">@Loc.T("contact.email")</span>
            <span class="contact-value">zhusupovsyimyk66@@gmail.com</span>
            <span class="contact-hint">@Loc.T("contact.copy")</span>
        </div>
        <a class="contact-card" href="tel:+48503442257">
            <span class="contact-label">@Loc.T("contact.phone")</span>
            <span class="contact-value">+48 503 442 257</span>
        </a>
        <a class="contact-card" href="https://github.com/shiga69" target="_blank" rel="noopener noreferrer">
            <span class="contact-label">@Loc.T("contact.github")</span>
            <span class="contact-value">github.com/shiga69 ↗</span>
        </a>
        <a class="contact-card" href="https://linkedin.com" target="_blank" rel="noopener noreferrer">
            <span class="contact-label">@Loc.T("contact.linkedin")</span>
            <span class="contact-value">LinkedIn Profile ↗</span>
        </a>
    </div>
</section>

<footer class="footer">
    <p>© @DateTime.Now.Year Syimyk Zhusupov — @Loc.T("footer.rights")</p>
</footer>

<!-- Toast notification for copy -->
@if (showCopiedToast)
{
    <div class="toast-notice">
        @Loc.T("contact.copied")
    </div>
}

<!-- Certificate Modal -->
@if (ActiveCertPath != null)
{
    <div class="cert-modal-overlay" @onclick="CloseCertModal">
        <div class="cert-modal" @onclick:stopPropagation="true">
            <button class="cert-modal-close" @onclick="CloseCertModal">✕</button>
            <embed src="@ActiveCertPath" type="application/pdf" class="cert-modal-pdf" />
            <a class="cert-modal-download" href="@ActiveCertPath" target="_blank" rel="noopener noreferrer">
                Open in new tab ↗
            </a>
        </div>
    </div>
}

@code {
    private string? ActiveCertPath;
    private bool isMobileMenuOpen = false;
    private bool showCopiedToast = false;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("siteInterop.initScrollReveal");
        }
    }

    private async Task Scroll(string id)
    {
        await JS.InvokeVoidAsync("siteInterop.smoothScrollTo", id);
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private async Task MobileNavClick(string id)
    {
        isMobileMenuOpen = false;
        await Scroll(id);
    }

    private void ToggleLang() => Loc.Toggle();

    private void ShowCert(string path) => ActiveCertPath = path;

    private void CloseCertModal() => ActiveCertPath = null;

    private async Task CopyEmail()
    {
        await JS.InvokeVoidAsync("siteInterop.copyToClipboard", "zhusupovsyimyk66@gmail.com");
        showCopiedToast = true;
        StateHasChanged();
        await Task.Delay(2500);
        showCopiedToast = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }
}
