            </div>
        </div>

        <div class="skill-category-card">
            <div class="skill-category-header">
                <span class="category-icon">🌐</span>
                <h3>@Loc.T("skills.networking")</h3>
            </div>
            <div class="tag-cloud">
                <span class="tag">TCP/IP Protocol Suite</span>
                <span class="tag">DNS &amp; DHCP</span>
                <span class="tag">Wireshark</span>
                <span class="tag">Cisco Packet Tracer</span>
                <span class="tag">VLAN &amp; Inter-VLAN Routing</span>
                <span class="tag">ACLs / Traffic Filtering</span>
                <span class="tag">Network Troubleshooting</span>
                <span class="tag">OSI Model</span>
            </div>
        </div>

        <div class="skill-category-card">
            <div class="skill-category-header">
                <span class="category-icon">🛠️</span>
                <h3>@Loc.T("skills.tools")</h3>
            </div>
            <div class="tag-cloud">
                <span class="tag">Linux (Ubuntu / Debian)</span>
                <span class="tag">Bash &amp; Shell Scripting</span>
                <span class="tag">Git &amp; GitHub</span>
                <span class="tag">Windows Administration</span>
                <span class="tag">Log Analysis (journalctl)</span>
                <span class="tag">Security Baseline Hardening</span>
                <span class="tag">Python</span>
            </div>
        </div>
